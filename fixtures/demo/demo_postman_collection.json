{
  "info": {
    "name": "Aegis EV Portfolio Demo Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Portfolio",
      "item": [
        {
          "name": "Read homepage",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://portfolio.example.test/"
            },
            "header": []
          }
        },
        {
          "name": "Read API profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "https://api.portfolio.example.test/api/profile?demo_token=not-a-real-demo-token-1234567890"
            },
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer not-a-real-demo-token-1234567890"
              }
            ]
          }
        }
      ]
    }
  ]
}
